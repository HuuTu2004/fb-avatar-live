# Facebook comments. FB_OBJECT_ID is the live-video or post object ID.
COMMENT_SOURCE=demo
FB_GRAPH_VERSION=v26.0
FB_OBJECT_ID=
FB_PAGE_ACCESS_TOKEN=
FB_FETCH_LIMIT=100
FB_POLL_SECONDS=2
FB_BATCH_SECONDS=3
FB_BATCH_SIZE=8

# Facebook personal-profile LIVE comments via Social Stream Ninja browser extension.
# Keep the Facebook viewer tab open and enable SSN remote API + chat relay.
SSN_SESSION_ID=

# TikTok LIVE comments. Use the broadcaster username without @.
# TikTok does not provide a public official LIVE chat API; this uses Webcast.
TIKTOK_UNIQUE_ID=

# OpenAI Responses API; all generative LLM calls use gpt-6-luna.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_MAX_REPLY_CHARS=260
PAUSE_AI_SPEECH=false
# Turn on only when Vòng Chú Lăng Nghiêm is visibly attached to this live cart.
# The spoken mention stays brief; the live video shows a commerce label when enabled.
AFFILIATE_CART_CONFIRMED=false
# Dashboard > Noi dung AI saves LLM_REPLY_SETTINGS as single-line JSON.
# It changes style/topics for new replies; application safety rules stay in code.

# ZeroTTS. Use a materialized local model directory to avoid ONNX symlink issues.
ZEROTTS_MODEL_DIR=/workspace/models/zerotts
ZEROTTS_VOICE=maichi
ZEROTTS_THREADS=4
ZEROTTS_PROVIDER=cpu
ZEROTTS_WARMUP=true
SPEECH_CHUNK_CHARS=260

# MuseTalk service, kept in its own Python 3.10/CUDA environment.
MUSETALK_URL=http://127.0.0.1:18081
MUSETALK_BATCH_SIZE=20
MUSETALK_XFORMERS=true
MUSETALK_WARMUP=true
MUSETALK_BBOX_SMOOTH_WINDOW=7

# The pipeline publishes H.264 + Opus locally; MediaMTX exposes it as WebRTC.
STREAM_URL=rtsp://127.0.0.1:8554/avatar
# Complete private RTMPS ingest URL from Facebook Live Producer.
FACEBOOK_SERVER_URL=rtmps://live-api-s.facebook.com:443/rtmp/
FACEBOOK_STREAM_URL=
AVATAR_VIDEO=/workspace/assets/avatar.mp4
AVATAR_IDLE_FRAME_SECONDS=
# Optional quiet instrumental bed, mixed continuously beneath the voice.
BACKGROUND_MUSIC_FILE=/workspace/fb-avatar-live/assets/meditation-ambient.ogg
BACKGROUND_MUSIC_VOLUME=0.10
OUTPUT_WIDTH=1280
OUTPUT_HEIGHT=720
OUTPUT_FPS=25
VIDEO_ENCODER=h264_nvenc
VIDEO_BITRATE=4500k
IDLE_CHUNK_SECONDS=0.2
STREAM_PREBUFFER_SEGMENTS=2

DATA_DIR=/workspace/fb-avatar-live/data
QUEUE_SIZE=24
LOG_LEVEL=INFO
ZEROTTS_VOICES_HOME=/workspace/fb-avatar-live/data/voices

# For local testing without Facebook, set COMMENT_SOURCE=demo and append JSON
# lines such as {"id":"1","author":"An","message":"Xin chào"}.
DEMO_COMMENTS_FILE=/workspace/fb-avatar-live/data/demo_comments.jsonl
DEMO_SALES_MODE=false
